;;;; inspect/gen-rearm-spend.lisp — writes inspect/vectors/rearm_spend.txt, the DEP-06 Phase 4
;;;; (draft) re-arm recovery spend vector shared with deposits-rust
;;;; (deposits-core/tests/rearm_spend_vector.rs).  Run after harness.lisp:
;;;;   sbcl --load inspect/harness.lisp --load inspect/gen-rearm-spend.lisp
;;;; Keys follow lottery_subsets.txt: participants from secrets [i;32] with commitments [i;20]
;;;; and targets "tb1p<i>", voters from secrets [20+j;32], threshold floor(r/2)+1, signet.  The
;;;; spend is of lottery output 11..11:0 worth 50,000,000 sats into 5120 22..22.

(in-package #:cl-deposits.test)

(defun xonly-of (priv) (up:x-only (up:compressed-pubkey (tk priv))))

(defun rs-lottery (k r)
  (let ((seed (lambda (i) (gossamer:pooled-copy (make-array 32 :element-type '(unsigned-byte 8) :initial-element i)))))
    (lot:build-lottery (loop for i from 1 to k
                             collect (lot:make-participant :pubkey (xonly-of (funcall seed i))
                                                           :commitment (make-array 20 :element-type '(unsigned-byte 8) :initial-element i)
                                                           :target (format nil "tb1p~a" i)))
                       (loop for j from 1 to r collect (xonly-of (funcall seed (+ 20 j))))
                       (1+ (floor r 2)) :network :signet)))

(defparameter *rs-txid* (make-array 32 :element-type '(unsigned-byte 8) :initial-element #x11))
(defparameter *rs-next-spk* (u:cat (u:octets #x51 #x20) (make-array 32 :element-type '(unsigned-byte 8) :initial-element #x22)))
(defparameter *rs-cases* '((2 3 0 2) (2 3 1 2) (2 3 3 2) (3 5 0 5) (3 5 1 5) (3 5 2 5) (3 5 3 5) (7 7 0 2) (7 7 3 2)))

(with-open-file (out (vector-path "rearm_spend.txt") :direction :output :if-exists :supersede)
  (format out "# DEP-06 Phase 4 (draft): the re-arm round's recovery spend, unsigned, its fee and vsize.~%")
  (format out "# Generated by cl-deposits inspect/gen-rearm-spend.lisp; see that file for the keys.~%")
  (dolist (c *rs-cases*)
    (destructuring-bind (k r tier feerate) c
      (multiple-value-bind (tx fee vsize) (lot:rearm-spend (rs-lottery k r) *rs-txid* 0 50000000 tier *rs-next-spk* :feerate feerate)
        (format out "VEC k=~a r=~a tier=~a feerate=~a tx=~a fee=~a vsize=~a~%"
                k r tier feerate (u:bytes->hex (btx:serialize-tx tx :witness nil)) fee vsize)))))
(format t "~&wrote ~a~%" (vector-path "rearm_spend.txt"))

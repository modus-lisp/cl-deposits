;;;; inspect/gen-rearm-windows.lisp — writes inspect/vectors/rearm_windows.json, the DEP-06 Phase 4
;;;; step 3 re-arm windows (strict-lottery-v8, ruled 2026-11-07), shared with deposits-rust
;;;; (deposits-core/tests/rearm_windows_vector.rs).  Run after harness.lisp:
;;;;   sbcl --load inspect/harness.lisp --load inspect/gen-rearm-windows.lisp
;;;; Each case gives the round's opening inputs (h_l, revealed, w), a tip, and the signed heights of
;;;; the round's ELIGIBLE arms: a window's cut is non-empty iff one of them lies in it.  (The cut
;;;; itself, with its grounds, accused exclusion and pledges, has its own vectors.)

(in-package #:cl-deposits.test)

(defparameter *rw-cases*
  ;; name h_l revealed w tip arms
  '(("scheduled window takes the arm" 1000 nil 6 1080 (1075))
    ("tip at the close: not closed yet" 1000 nil 6 1078 (1075))
    ("empty scheduled window, the reopening takes it" 1000 nil 6 1086 (1081))
    ("revealers: the round opens at h_l+144" 1000 t 6 1160 (1150))
    ("4a6487ee: past both windows, between recurring ones" 649 nil 6 1750 ())
    ("4a6487ee: armed in the next recurring window, which has closed" 649 nil 6 1880 (1875))
    ("4a6487ee: tip inside a recurring window, not armed yet" 649 nil 6 1876 ())
    ("an arm between windows belongs to none" 649 nil 6 1000 (800))
    ("the first non-empty window wins over a later one" 649 nil 6 1200 (870 1015))
    ("w = 72: the period is 288" 2000 nil 72 2700 (2650))
    ("w = 71: the period is still 144" 2000 nil 71 2400 ())))

(defun rw-json-window (&optional j o c) (if j (format nil "[~d,~d,~d]" j o c) "null"))

(with-open-file (out (vector-path "rearm_windows.json") :direction :output :if-exists :supersede)
  (format out "{~%  \"description\": \"DEP-06 Phase 4 step 3 (strict-lottery-v8, ruled 2026-11-07): a re-arm round's arm windows recur while the lottery output is unspent. o = h_l + (revealed ? 144 : 72); period k = 144*ceil((2w+1)/144); window 0 = (o, o+w], 1 = (o+w, o+2w], j>=2 = (o+(j-1)k, o+(j-1)k+w]. A window's cut is non-empty iff one of arms lies in it. round_window: the first window closed by tip (tip > closes) with a non-empty cut, as [j, opens, closes], else null. open: the window tip lies in (opens < tip <= closes), else null. next_opens: the first window opening at or after tip. windows: windows 0..5. Generated by cl-deposits inspect/gen-rearm-windows.lisp.\",~%  \"cases\": [~%")
  (loop for (c . more) on *rw-cases*
        do (destructuring-bind (name h-l revealed w tip arms) c
             (let* ((o (+ h-l (if revealed 144 lot:+reveal-csv+)))
                    (nonempty (lambda (op cl) (some (lambda (a) (< op a (1+ cl))) arms))))
               (format out "    {\"name\": ~s, \"h_l\": ~d, \"revealed\": ~:[false~;true~], \"w\": ~d, \"tip\": ~d, \"arms\": [~{~d~^,~}],~%"
                       name h-l revealed w tip arms)
               (format out "     \"opens\": ~d, \"period\": ~d, \"windows\": [~{~a~^,~}],~%" o (lot:rearm-period w)
                       (loop for j below 6 collect (multiple-value-bind (op cl) (lot:rearm-window-nth o w j) (format nil "[~d,~d]" op cl))))
               (format out "     \"round_window\": ~a, \"open\": ~a, \"next_opens\": ~d}~:[~;,~]~%"
                       (multiple-value-call #'rw-json-window (lot:rearm-round-window o w tip nonempty))
                       (multiple-value-call #'rw-json-window (lot:rearm-open-window o w tip))
                       (lot:rearm-next-window o w tip)
                       more))))
  (format out "  ]~%}~%"))
(format t "~&wrote ~a~%" (vector-path "rearm_windows.json"))

;;;; inspect/gen-rearm-witness.lisp — writes inspect/vectors/rearm_witness.txt, the witness stack of
;;;; a DEP-06 Phase 4 re-arm spend as its proposer assembles it from the voters' signatures,
;;;; shared with deposits-rust (deposits-core/tests/rearm_witness_vector.rs).  Run after harness.lisp:
;;;;   sbcl --load inspect/harness.lisp --load inspect/gen-rearm-spend.lisp --load inspect/gen-rearm-witness.lisp
;;;; Lotteries as rearm_spend.txt (gen-rearm-spend.lisp's RS-LOTTERY).  MASK names, in the sorted
;;;; recovery-voter order, which voters signed; voter i's signature is 64 bytes of #x40+i (the
;;;; stack's shape is under test, not the signatures).  WITNESS is the stack, items comma-separated
;;;; (an empty item is empty): above threshold 1, one item per voter in REVERSE sorted order (CHECKSIGADD
;;;; consumes the lowest key last), empty where absent; at threshold 1, the one signature present;
;;;; then the tier's leaf script and control block.

(in-package #:cl-deposits.test)

(defparameter *rw-cases* '((2 3 0 "110") (2 3 0 "011") (2 3 1 "010") (3 5 0 "11100") (3 5 1 "10110")
                           (3 5 2 "00001") (3 5 3 "10000") (7 7 0 "1011001")))

(with-open-file (out (vector-path "rearm_witness.txt") :direction :output :if-exists :supersede)
  (format out "# DEP-06 Phase 4: a re-arm spend's witness stack, assembled from the voters' signatures.~%")
  (format out "# Generated by cl-deposits inspect/gen-rearm-witness.lisp; see that file for the layout.~%")
  (dolist (c *rw-cases*)
    (destructuring-bind (k r tier mask) c
      (let* ((l (rs-lottery k r))
             (sigs (loop for i from 0 below r
                         collect (and (char= (char mask i) #\1)
                                      (make-array 64 :element-type '(unsigned-byte 8) :initial-element (+ #x40 i)))))
             (w (lot:recovery-witness l tier sigs)))
        (format out "VEC k=~a r=~a tier=~a mask=~a witness=~{~a~^,~}~%"
                k r tier mask (mapcar #'u:bytes->hex w))))))
(format t "~&wrote ~a~%" (vector-path "rearm_witness.txt"))

;;;; inspect/gen-lottery-voters.lisp — writes inspect/vectors/lottery_voters_accused.txt, the
;;;; strict-lottery-v8 (provisional) recovery-voter vector shared with deposits-rust
;;;; (deposits-core/tests/lottery_voters_accused_vector.rs).  Run after harness.lisp:
;;;;   sbcl --load inspect/harness.lisp --load inspect/gen-lottery-voters.lisp
;;;; A 5-member quorum's voters come from secrets [21..25; 32]; three participants from secrets
;;;; [1..3; 32] with commitments [i;20] and targets "tb1p<i>", signet.  For each accused set the
;;;; voters are the quorum without the accused, the threshold the strict majority of what remains.

(in-package #:cl-deposits.test)

(defun lv-xonly (i) (up:x-only (up:compressed-pubkey (tk (gossamer:pooled-copy (make-array 32 :element-type '(unsigned-byte 8) :initial-element i))))))

(defun lv-lottery (accused-seeds)
  (multiple-value-bind (voters threshold)
      (lot:strict-voters (loop for j from 21 to 25 collect (lv-xonly j)) (mapcar #'lv-xonly accused-seeds))
    (values (lot:build-lottery (loop for i from 1 to 3
                                     collect (lot:make-participant :pubkey (lv-xonly i)
                                                                   :commitment (make-array 20 :element-type '(unsigned-byte 8) :initial-element i)
                                                                   :target (format nil "tb1p~a" i)))
                               voters threshold :network :signet)
            voters threshold)))

(defparameter *lv-cases* '(("none" ()) ("one" (22)) ("three" (22 23 24)) ("all" (21 22 23 24 25))))

(with-open-file (out (vector-path "lottery_voters_accused.txt") :direction :output :if-exists :supersede)
  (format out "# strict-lottery-v8 (provisional): recovery voters = the quorum minus Accused(grounds), every~%")
  (format out "# threshold over what remains.  Generated by cl-deposits inspect/gen-lottery-voters.lisp.~%")
  (dolist (c *lv-cases*)
    (destructuring-bind (name seeds) c
      (multiple-value-bind (l voters threshold) (lv-lottery seeds)
        (let* ((specs (and voters (lot::recovery-specs threshold)))
               (sub (and (lot:lottery-subsets l) (nth (lot:subset-leaf-index l '(0 1)) (lot:lottery-leaves l))))
               (rec (and voters (nth (lot::recovery-leaf-index l 0) (lot:lottery-leaves l)))))
          (format out "VEC case=~a accused=~{~a~^,~} voters=~{~a~^,~} threshold=~a tiers=~{~a~^,~} leaves=~a address=~a subset01=~a recovery144=~a~%"
                  name (or seeds '("-")) (or (mapcar #'u:bytes->hex (lot::sorted-keys voters)) '("-")) threshold
                  (or (mapcar #'cdr specs) '("-")) (length (lot:lottery-leaves l)) (lot:lottery-address l)
                  (if sub (u:bytes->hex sub) "-") (if rec (u:bytes->hex rec) "-")))))))
(format t "~&wrote ~a~%" (vector-path "lottery_voters_accused.txt"))

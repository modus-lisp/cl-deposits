(with-gate ("DEP-06 §Confiscation obligations: the shared vector (owed entries, confiscation shape, records, residue)")
  (let ((kv (make-hash-table :test #'equal)) (rewritten '()))
    (flet ((parse-pairs (s) (and (plusp (length s)) (mapcar (lambda (x) (uiop:split-string x :separator ":")) (uiop:split-string s :separator ",")))))
      (with-open-file (in (vector-path "confiscation_obligations.txt"))
        (loop for line = (read-line in nil) while line
              unless (or (zerop (length line)) (char= (char line 0) #\#))
                do (let ((w (uiop:split-string line :separator " ")))
                     (cond
                       ((string= (first w) "case"))
                       ((string= (first w) "entry")
                        (multiple-value-bind (spk sats) (lg:owed-spk-sats (list :deposit-id (u:hex->bytes (second w)) :amount (parse-integer (third w)) :descriptor (fourth w)))
                          (check-equal (format nil "owed ~a" (subseq (second w) 0 8)) (if spk (format nil "~a:~a" (u:bytes->hex spk) sats) "residue") (sixth w))))
                       ((string= (first w) "tx")
                        (let* ((field (lambda (k) (let ((x (find-if (lambda (s) (and (>= (length s) (length k)) (string= k (subseq s 0 (length k))))) w)))
                                                    (subseq x (length k)))))
                               (swept (mapcar (lambda (p) (list (u:hex->bytes (first p)) (parse-integer (second p)) (parse-integer (third p))))
                                              (parse-pairs (funcall field "swept="))))
                               (outs (mapcar (lambda (p) (cons (u:hex->bytes (first p)) (parse-integer (second p)))) (parse-pairs (funcall field "outs="))))
                               (tx (lot:confiscation-tx :vault (list (make-array 32 :element-type '(unsigned-byte 8) :initial-element #xa1) 0 50000000)
                                                        :swept swept :lottery-spk (u:hex->bytes (gethash "lottery_spk" kv))
                                                        :voters (parse-integer (gethash "voters" kv)) :locktime (parse-integer (gethash "locktime" kv))
                                                        :respectful (string= (funcall field "respectful=") "1")
                                                        :obligations-sats (parse-integer (funcall field "obligations="))
                                                        :residue-sats (parse-integer (funcall field "residue=")) :splice-outs outs
                                                        :operator-pubkey33 (u:hex->bytes (gethash "operator" kv))
                                                        :anchor (u:hex->bytes (gethash "anchor" kv)))))
                          (push (cons line (u:bytes->hex (btx:serialize-tx tx :witness nil))) rewritten)
                          (check-equal (format nil "confiscation ~a" (second w)) (u:bytes->hex (btx:serialize-tx tx :witness nil)) (car (last w)))))
                       ((string= (first w) "record")
                        (let ((l (lg:make-ledger)))
                          (setf (lg::ledger-id l) (u:hex->bytes (gethash "ledger" kv)) (lg:ledger-operator-key l) (u:hex->bytes (gethash "operator" kv))
                                (lg::ledger-dispute-state l) (intern (string-upcase (third w)) :keyword))
                          (check-equal (format nil "ObligationRecord ~a" (second w))
                                       (handler-case (let ((lg:*block-height* 160)) (lg:apply-operation l (op:decode-operation (u:hex->bytes (fifth w)))) "ok")
                                         (error () "refuse"))
                                       (fourth w))))
                       ((string= (first w) "credit")
                        (let ((l (lg:make-ledger)))
                          (setf (lg::ledger-id l) (u:hex->bytes (gethash "ledger" kv)) (lg:ledger-operator-key l) (u:hex->bytes (gethash "operator" kv))
                                (lg::ledger-reserves-amount l) (parse-integer (gethash "reserves" kv)))
                          (let ((lg:*block-height* 100)) (lg:apply-operation l (op:decode-operation (u:hex->bytes (gethash "accept" kv)))))
                          (setf (lg:ledger-confiscation-txid l) (u:hex->bytes (gethash "confiscation_txid" kv)))
                          (let ((lg:*block-height* 300)) (lg:apply-operation l (op:decode-operation (u:hex->bytes (second w)))))
                          (setf (gethash :residue-ledger kv) l)))
                       ((string= (first w) "balance")
                        (let ((d (gethash (u:hex->bytes (second w)) (lg:ledger-deposits (gethash :residue-ledger kv)))))
                          (check-equal (format nil "residue credit ~a" (subseq (second w) 0 8)) (if d (lg:deposit-balance d) 0) (parse-integer (third w)))))
                       (t (setf (gethash (first w) kv) (second w))))))))
    ;; CL_DEPOSITS_WRITE_VECTORS: the tx lines' expected bytes from our builder
    (when (uiop:getenv "CL_DEPOSITS_WRITE_VECTORS")
      (let ((text (uiop:read-file-string (vector-path "confiscation_obligations.txt"))))
        (dolist (r rewritten)
          (let* ((line (car r)) (cut (+ (search " -> " line) 4)))
            (setf text (let ((at (search line text))) (concatenate 'string (subseq text 0 (+ at cut)) (cdr r) (subseq text (+ at (length line))))))))
        (with-open-file (o (vector-path "confiscation_obligations.txt") :direction :output :if-exists :supersede)
          (write-string text o))))))

(with-gate ("DEP-06 obligations: offer evidence, payment records, UnhonouredObligation (proof 11) — the shared vector")
  (let ((kv (make-hash-table :test #'equal)) (history '()))
    (with-open-file (in (vector-path "unhonoured_obligation.txt"))
      (loop for line = (read-line in nil) while line
            unless (or (zerop (length line)) (char= (char line 0) #\#))
              do (let ((w (uiop:split-string line :separator " ")))
                   (labels ((dec (k) (up:decode-update (u:hex->bytes (gethash k kv))))
                            (hob (b) (loop for u in history when (equalp b (up:update-block-hash u)) return (up:update-block-height u)))
                            (acquire () (find :dispute-acquire history :key (lambda (u) (op:operation-type (op:decode-operation (up:update-message u))))))
                            (conf () (btx:parse-tx (cl-consensus.wire:make-reader (u:hex->bytes (gethash "confiscation" kv)))))
                            (args (kind) (if (string= kind "migration")
                                             (list :notice-update (dec "notice") :qb-update (dec "qb"))
                                             (list :uncredited-proof (gethash "payment" kv)))))
                     (cond
                       ((string= (first w) "update") (setf history (append history (list (up:decode-update (u:hex->bytes (second w)))))))
                       ((string= (first w) "payment") (setf (gethash "payment" kv) (subseq line 8)))
                       ((string= (first w) "offer")
                        (let ((p (fr:json->proof (w:parse-json (subseq line (+ 6 (search " json " line)))))))
                          (check-equal (format nil "offer evidence ~a: hash" (second w)) (u:bytes->hex (fr:proof-hash p)) (sixth w))
                          (check-equal (format nil "offer evidence ~a: verdict" (second w))
                                       (if (fr:verify-proof p :history (remove-if (lambda (u) (> (up:update-seq u) 5)) history) :height-of-block #'hob) "1" "0")
                                       (fourth w))))
                       ((string= (first w) "record")
                        (check-equal (format nil "payment ObligationRecord ~a" (second w))
                                     (handler-case (let ((l (lg:replay (remove-if (lambda (u) (> (up:update-seq u) 6)) history))) (lg:*block-height* 172))
                                                     (lg:apply-operation l (op:decode-operation (u:hex->bytes (fourth w)))) "ok")
                                       (error () "refuse"))
                                     (third w)))
                       ((string= (first w) "produce")
                        (let ((p (apply #'fr:unhonoured-obligation-proof
                                        (remove-if (lambda (u) (> (up:update-seq u) (parse-integer (third w)))) history) (acquire) (conf)
                                        (args (second w)))))
                          (check-equal (format nil "producer ~a up to ~a" (second w) (third w))
                                       (if p (princ-to-string (up:update-seq (up:decode-update (u:hex->bytes (getf (getf p :evidence) :proof-update))))) "none")
                                       (fourth w))))
                       ((string= (first w) "proof")
                        (let* ((mig (string= (second w) "migration"))
                               (proof (list :type :unhonoured-obligation :accused (gethash "accused" kv) :ledger-id (gethash "ledger" kv)
                                            :evidence (list :source-notice-update (if mig (gethash "notice" kv) "") :source-qb-update (if mig (gethash "qb" kv) "")
                                                            :uncredited-proof (if mig "" (gethash "payment" kv))
                                                            :acquire-update (u:bytes->hex (up:encode-update (acquire)))
                                                            :confiscation-tx (gethash "confiscation" kv)
                                                            :proof-update (u:bytes->hex (up:encode-update (find (parse-integer (third w)) history :key #'up:update-seq)))))))
                          (check-equal (format nil "proof 11 ~a hash at ~a" (second w) (third w)) (u:bytes->hex (fr:proof-hash proof)) (seventh w))
                          (check-equal (format nil "proof 11 ~a verdict at ~a" (second w) (third w))
                                       (if (fr:verify-proof proof :history history :height-of-block #'hob) "1" "0") (fifth w))))
                       ((string= (first w) "json")
                        ;; proof 11 as we broadcast it: our encoding reproduces the line byte for
                        ;; byte (the reference parses it: deposits-core obligations_vector.rs)
                        (let* ((mig (string= (second w) "migration"))
                               (proof (list :type :unhonoured-obligation :accused (gethash "accused" kv) :ledger-id (gethash "ledger" kv)
                                            :evidence (list :source-notice-update (if mig (gethash "notice" kv) "") :source-qb-update (if mig (gethash "qb" kv) "")
                                                            :uncredited-proof (if mig "" (gethash "payment" kv))
                                                            :acquire-update (u:bytes->hex (up:encode-update (acquire)))
                                                            :confiscation-tx (gethash "confiscation" kv)
                                                            :proof-update (u:bytes->hex (up:encode-update (find (parse-integer (third w)) history :key #'up:update-seq)))))))
                          (check-equal (format nil "proof 11 ~a at ~a: the broadcast JSON" (second w) (third w))
                                       (w:json (fr:proof->json proof))
                                       (subseq line (+ (search (third w) line :start2 5) (length (third w)) 1)))))
                       (t (setf (gethash (first w) kv) (second w))))))))))

;;; inspect/vectors/proof_json.txt: a proof's JSON form, shared with deposits-rust
;;; (deposits-protocol/tests/fixtures/proof_json.txt): hex byte strings, arrays accepted.
(with-gate ("DEP-06 proof JSON: hex byte strings, the earlier arrays accepted")
  (let ((kv (make-hash-table :test #'equal)))
    (with-open-file (in (vector-path "proof_json.txt"))
      (loop for line = (read-line in nil) while line
            unless (or (zerop (length line)) (char= (char line 0) #\#))
              do (let ((sp (position #\Space line))) (setf (gethash (subseq line 0 sp) kv) (subseq line (1+ sp))))))
    (dolist (form '("hex" "array"))
      (let ((p (fr:json->proof (w:parse-json (gethash form kv)))))
        (check-equal (format nil "the ~a form decodes to the proof with the vector's hash" form)
                     (u:bytes->hex (fr:proof-hash p)) (gethash "hash" kv))
        (check-equal (format nil "the ~a form re-encodes as the hex form" form)
                     (w:json (fr:proof->json p)) (gethash "hex" kv))))))

;;; inspect/vectors/vault_spend_anchor.txt: DEP-06 proof 10 and §Spend challenge, shared with
;;; deposits-rust (deposits-core/tests/vectors).  A vault spend carries an anchor H, or it is theft on
;;; its face.  Anchored, it is answered only by a QuorumBegin whose previous_hash is H, signed by the
;;; operator, naming the spend among its rungs, cosigned to the spend's tier threshold by its keys;
;;; anything else (a forged signature, too few cosignatures, another txid, another parent, a child of
;;; H that is no QuorumBegin) answers nothing and proves nothing.  Proved: unanchored on the witness
;;; alone; anchored only by a challenge that lapsed (a block w past the later of challenge and spend)
;;; with no answer.  Generated by cl-deposits with CL_DEPOSITS_WRITE_VECTORS.
(with-gate ("DEP-06 vault spend: the anchor, answers and the two proof forms, against the shared vector")
  (when (uiop:getenv "CL_DEPOSITS_WRITE_VECTORS")
    (let* ((op-priv 424242) (m-privs '(515151 616161 717171)) (c-priv 818181)
           (pa (up:compressed-pubkey (tk op-priv))) (pms (mapcar (lambda (p) (up:compressed-pubkey (tk p))) m-privs)) (pc (up:compressed-pubkey (tk c-priv)))
           (lid (u:sha256 (hx "1e"))) (cid (u:sha256 (hx "1c")))
           (zero (make-array 32 :element-type '(unsigned-byte 8) :initial-element 0))
           (vault-txid (u:sha256 (u:ascii->bytes "vault")))
           (block (lambda (h) (u:sha256 (u:ascii->bytes (format nil "block ~a" h)))))
           (sign (lambda (u priv) (up:sign-operator u (tk priv)) u))
           (mk (lambda (priv pub ledger seq prev op &key (height (+ 100 seq)) cosigners)
                 (let ((u (up:make-signed-update :operator-id pub :ledger-id ledger :seq seq :prev-hash prev
                                                 :block-height height :block-hash (funcall block height)
                                                 :message (op:encode-operation op))))
                   (dolist (cp cosigners)
                     (push (up:sign-cosignature u (tk cp) (up:compressed-pubkey (tk cp)) (u:sha256 (u:ascii->bytes "member tip"))) (up:update-cosignatures u)))
                   (funcall sign u priv))))
           (reserves (rs:build-reserves :operator pa :members pms :ledger-hash (u:sha256 (hx "aa")) :quorum-expiry 5000
                                        :ruleset "cltv-offset-v2" :network :signet))
           (qb (lambda (out &optional rungs (ruleset "anchor-ladder-v5")) (append (list :type :quorum-begin :reserves-id (rs:reserves-address reserves) :spending-txid out
                                                           :new-outpoint-txid out :new-outpoint-vout 0 :amount 40000000 :quorum-expiry 5000
                                                           :ledger-hash (u:sha256 (hx "aa")) :quorum-members pms :collateral-amount 10000000
                                                           :protocol-version ruleset)
                                                     (when rungs (list :rotation-rungs (apply #'u:cat rungs))))))
           (fee (lambda (n) (list :type :fee-change :deposit-id (op:deposit-id "x") :new-fees (op:make-fees) :effective-block n)))
           (u0 (funcall mk op-priv pa lid 0 zero (list :type :ledger-open :operator-id pa :reserves-id "g" :genesis-block 0 :reserves-amount 1000 :collateral-amount 500)))
           (u1 (funcall mk op-priv pa lid 1 (up:chain-hash u0) (funcall qb vault-txid)))
           (u2 (funcall mk op-priv pa lid 2 (up:chain-hash u1) (funcall fee 1)))
           ;; DEP-18: the same vault under a QuorumBegin naming cltv-offset-v2 (a decoy at seq 9).
           ;; Proofs that name it as governing are judged under cltv-offset-v2, which has no proof 10.
           (u9 (funcall mk op-priv pa lid 9 (u:sha256 (hx "09")) (funcall qb vault-txid nil "cltv-offset-v2")))
           (h (up:chain-hash u2))
           (prevouts (vector (cons 50000 (rs:reserves-spk reserves))))
           (spend (lambda (outs)
                    (let* ((tx (btx:make-tx :version 2 :locktime 0 :segwit-p t
                                            :inputs (list (btx:make-txin :prev-hash vault-txid :prev-index 0 :script (u:octets) :sequence #xfffffffd))
                                            :outputs (loop for (spk . v) in outs collect (btx:make-txout :value v :script spk))
                                            :witnesses (list nil)))
                           (sigs (rot:sign-tier tx 0 prevouts reserves 0
                                                (mapcar (lambda (p) (cons (up:x-only (up:compressed-pubkey (tk p))) (tk p))) m-privs))))
                      (rot:attach-tier-witness tx 0 reserves 0 sigs))))
           (next-spk (u:cat (hx "5120") (u:sha256 (u:ascii->bytes "next vault"))))
           (thief (u:cat (hx "5120") (u:sha256 (u:ascii->bytes "thief"))))
           (rot0 (funcall spend (list (cons next-spk 49000) (cons (rot:anchor-script h) 0))))
           (rot1 (funcall spend (list (cons next-spk 48000) (cons (rot:anchor-script h) 0))))
           (rot2 (funcall spend (list (cons next-spk 47000) (cons (rot:anchor-script h) 0))))
           (bare (funcall spend (list (cons thief 49000))))
           (forged (funcall spend (list (cons thief 49000) (cons (rot:anchor-script h) 0))))
           (rungs (list (btx:tx-txid rot0) (btx:tx-txid rot1)))
           (u3 (funcall mk op-priv pa lid 3 h (funcall qb (btx:tx-txid rot0) rungs) :cosigners m-privs))
           (u3x (let ((u (funcall mk op-priv pa lid 3 h (funcall qb (u:sha256 (u:ascii->bytes "forged sig")) (list (btx:tx-txid forged))) :cosigners m-privs)))
                  (setf (aref (up:update-operator-sig u) 0) (logxor 1 (aref (up:update-operator-sig u) 0))) u))
           (u3c (funcall mk op-priv pa lid 3 h (funcall qb (u:sha256 (u:ascii->bytes "few cosigs")) (list (btx:tx-txid forged))) :cosigners (list (first m-privs))))
           ;; one cosignature short of the tier's threshold, which the operator's own signature makes up
           (u3t (funcall mk op-priv pa lid 3 h (funcall qb (btx:tx-txid rot2) (list (btx:tx-txid rot2))) :cosigners (subseq m-privs 0 2)))
           (u3o (funcall mk op-priv pa lid 3 h (funcall qb (u:sha256 (u:ascii->bytes "other")) (list (u:sha256 (u:ascii->bytes "other")))) :cosigners m-privs))
           (u3p (funcall mk op-priv pa lid 3 (u:sha256 (hx "e15e")) (funcall qb (btx:tx-txid forged) (list (btx:tx-txid forged))) :cosigners m-privs))
           (u3m (funcall mk (first m-privs) (first pms) lid 3 h (funcall qb (btx:tx-txid forged) (list (btx:tx-txid forged))) :cosigners m-privs))
           (u3n (funcall mk op-priv pa lid 3 h (funcall fee 2) :cosigners m-privs))
           (challenge (lambda (tx anchor height)
                        (funcall mk c-priv pc cid 7 (u:sha256 (u:ascii->bytes "challenger tip"))
                                 (list :type :quorum-challenge :challenged-ledger-id lid :challenged-txid (btx:tx-txid tx) :challenged-anchor anchor)
                                 :height height)))
           (proof (lambda (signer tx &key challenge lapse (governing 1))
                    (fr:make-unauthorized-vault-spend-proof (up:compressed-pubkey (tk signer)) (u:sha256 (hx "a11ce")) lid governing tx prevouts (funcall block 1000)
                                                            :challenge-update challenge :lapse-block-hash (and lapse (funcall block lapse)))))
           (updates (list u3n u0 u3x u2 u3c u1 u3o u3p u3m u3t u3 u9)))
      (with-open-file (o (vector-path "vault_spend_anchor.txt") :direction :output :if-exists :supersede)
        (format o "# DEP-06 proof 10 and §Spend challenge (shared cl-deposits / deposits-rust), generated by cl-deposits~%")
        (format o "# (inspect/rotation-test.lisp with CL_DEPOSITS_WRITE_VECTORS).  Every update a judge holds of the~%")
        (format o "# spent ledger (any order, decoys beside the real chain); the blocks it knows (hash height); the~%")
        (format o "# spends (signed, internal-order txids); answers: the spend's anchor and the update that answers~%")
        (format o "# it at tier 0 (its chain hash, or none); proofs: verdict, proof hash, the broadcast JSON.~%")
        (format o "# DEP-18: the governing QuorumBegin (seq 1) names anchor-ladder-v5; the twins *_under_cltv_offset_v2~%")
        (format o "# name a QuorumBegin at seq 9 for the same vault under cltv-offset-v2, which has no proof 10.~%")
        (format o "governing 1~%prevout 50000:~a~%" (u:bytes->hex (rs:reserves-spk reserves)))
        (dolist (u updates) (format o "update ~a~%" (u:bytes->hex (up:encode-update u))))
        (dolist (bh '(1000 1050 1073 1100)) (format o "block ~a ~a~%" (u:bytes->hex (funcall block bh)) bh))
        (loop for (name tx) in (list (list "rotation_rung0" rot0) (list "rotation_rung1" rot1) (list "operator_counts" rot2) (list "bare" bare) (list "forged_anchor" forged))
              do (format o "spend ~a ~a~%" name (u:bytes->hex (btx:serialize-tx tx))))
        (loop for (name tx want) in (list (list "rotation_rung0" rot0 u3) (list "rotation_rung1" rot1 u3) (list "operator_counts" rot2 u3t) (list "bare" bare nil) (list "forged_anchor" forged nil))
              do (format o "answer ~a ~a ~a~%" name (let ((a (rot:anchor-of tx))) (if a (u:bytes->hex a) "none"))
                         (if want (u:bytes->hex (up:chain-hash want)) "none")))
        (let ((c-forged (funcall challenge forged h 1001)) (c-rot (funcall challenge rot0 h 1001))
              (c-other (funcall challenge bare h 1001)))
          (loop for (name verdict p) in
                (list (list "unanchored" 1 (funcall proof (first m-privs) bare))
                      (list "unanchored_with_challenge" 0 (funcall proof (first m-privs) bare :challenge c-other :lapse 1100))
                      (list "anchored_without_challenge" 0 (funcall proof (first m-privs) forged))
                      (list "lapsed" 1 (funcall proof (second m-privs) forged :challenge c-forged :lapse 1073))
                      (list "lapse_too_early" 0 (funcall proof (second m-privs) forged :challenge c-forged :lapse 1050))
                      (list "challenge_of_another_spend" 0 (funcall proof (second m-privs) forged :challenge c-other :lapse 1100))
                      (list "lapsed_but_answered" 0 (funcall proof (third m-privs) rot0 :challenge c-rot :lapse 1100))
                      (list "not_a_signer" 0 (fr:make-unauthorized-vault-spend-proof pc (u:sha256 (hx "a11ce")) lid 1 bare prevouts (funcall block 1000)))
                      ;; DEP-18 twins: the same spends of a vault created under cltv-offset-v2
                      (list "unanchored_under_cltv_offset_v2" 0 (funcall proof (first m-privs) bare :governing 9))
                      (list "lapsed_under_cltv_offset_v2" 0 (funcall proof (second m-privs) forged :challenge c-forged :lapse 1073 :governing 9)))
                do (format o "proof ~a ~a ~a ~a~%" name verdict (u:bytes->hex (fr:proof-hash p)) (w:json (fr:proof->json p))))))))
  (let ((updates '()) (blocks (make-hash-table :test #'equalp)) (spends (make-hash-table :test #'equal)) (answers '()) (proofs '())
        (governing nil) (prevout nil))
    (with-open-file (in (vector-path "vault_spend_anchor.txt"))
      (loop for line = (read-line in nil) while line
            unless (or (zerop (length line)) (char= (char line 0) #\#))
              do (let ((w (uiop:split-string line :separator " ")))
                   (cond ((string= (first w) "update") (push (up:decode-update (u:hex->bytes (second w))) updates))
                         ((string= (first w) "governing") (setf governing (parse-integer (second w))))
                         ((string= (first w) "prevout") (setf prevout (second w)))
                         ((string= (first w) "block") (setf (gethash (u:hex->bytes (second w)) blocks) (parse-integer (third w))))
                         ((string= (first w) "spend") (setf (gethash (second w) spends) (btx:parse-tx (cl-consensus.wire:make-reader (u:hex->bytes (third w))))))
                         ((string= (first w) "answer") (push (rest w) answers))
                         ((string= (first w) "proof")
                          (push (list (second w) (third w) (fourth w)
                                      (subseq line (+ (search (fourth w) line) (length (fourth w)) 1)))
                                proofs))))))
    (check-equal "the vector names its answers and proofs" (list (length answers) (length proofs)) '(5 10))
    (let ((reserves (fr:spent-vault updates governing))
          (hob (lambda (b) (gethash b blocks))))
      (check "the spent vault is rebuilt from the governing QuorumBegin" reserves)
      (check-equal "the prevout is the vault's" prevout (format nil "50000:~a" (u:bytes->hex (rs:reserves-spk reserves))))
      (dolist (a (reverse answers))
        (destructuring-bind (name anchor want) a
          (let* ((tx (gethash name spends)) (got (and (rot:anchor-of tx) (fr:rotation-answer updates (rot:anchor-of tx) (btx:tx-txid tx) reserves 0))))
            (check-equal (format nil "~a: its anchor" name) (let ((x (rot:anchor-of tx))) (if x (u:bytes->hex x) "none")) anchor)
            (check-equal (format nil "~a: answered by" name) (if got (u:bytes->hex (up:chain-hash got)) "none") want)
            ;; whatever order the judge gathered the updates in
            (check-equal (format nil "~a: answered in the opposite order too" name)
                         (let ((g (and (rot:anchor-of tx) (fr:rotation-answer (reverse updates) (rot:anchor-of tx) (btx:tx-txid tx) reserves 0))))
                           (if g (u:bytes->hex (up:chain-hash g)) "none"))
                         want))))
      (dolist (p (reverse proofs))
        (destructuring-bind (name verdict hash json) p
          (let ((proof (fr:json->proof (w:parse-json json))))
            (check-equal (format nil "~a: proof hash" name) (u:bytes->hex (fr:proof-hash proof)) hash)
            (check-equal (format nil "~a: the JSON re-encodes" name) (w:json (fr:proof->json proof)) json)
            (check-equal (format nil "~a: ~:[rejected~;proven~]" name (string= verdict "1"))
                         (and (fr:verify-unauthorized-vault-spend proof updates hob
                                                                  :answered-fn (lambda (txid anchor reserves tier)
                                                                                 (fr:rotation-answer updates anchor txid reserves tier)))
                              t)
                         (string= verdict "1"))))))))

;;; inspect/vectors/ruleset_naming.txt: DEP-18, shared with deposits-rust.  Rulesets are named,
;;; not ordered.  seat and upgrade verdicts are consensus; plan is the reference operator policy.
(with-gate ("DEP-18 ruleset naming: the shared ruleset_naming vector")
  (flet ((rs (s) (if (string= s "-") nil s))
         (decls (s) (mapcar (lambda (m) (if (string= m "-") '() (uiop:split-string m :separator ",")))
                            (uiop:split-string s :separator ";")))
         (v (k) (string-downcase (symbol-name k))))
    (let ((n 0))
      (with-open-file (in (vector-path "ruleset_naming.txt"))
        (loop for line = (read-line in nil) while line
              unless (or (zerop (length line)) (char= (char line 0) #\#))
                do (let ((w (uiop:split-string line :separator " ")))
                     (incf n)
                     (cond
                       ((string= (first w) "seat")
                        (check-equal line (v (lg:seat-verdict (second w) (decls (third w)))) (fourth w)))
                       ((string= (first w) "upgrade")
                        (check-equal line (v (lg:upgrade-verdict (rs (second w)) (third w) (decls (fourth w)))) (fifth w)))
                       ((string= (first w) "plan")
                        (check-equal line (lg:planned-ruleset (rs (second w)) (decls (third w))) (fourth w)))
                       ((string= (first w) "propose")
                        (check-equal line (lg:proposed-ruleset (rs (second w)) (first (decls (third w)))) (fourth w)))
                       (t (check (format nil "unknown case ~a" line) nil))))))
      (check-equal "ruleset_naming cases" n 41))))

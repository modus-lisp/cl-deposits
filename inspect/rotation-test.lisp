;;; inspect/vectors/ruleset_gating.txt: DEP-18, shared with deposits-rust.  The registry, and each
;;; gated rule judged on the same input under anchor-ladder-v5 (where it convicts) and under an
;;; earlier ruleset or none (dormant).  Generated by cl-deposits with CL_DEPOSITS_WRITE_VECTORS.
(defparameter *registry-rules*
  '(("cltv-offset-v2") ("fee-cap-v3") ("balance-commit-v4" "missing_balance_commitment")
    ("anchor-ladder-v5" "signed_header" "born_expired" "collateral_floor" "vault_spend_proofs")
    ("balance-anchor-v6" "signed_header" "born_expired" "collateral_floor" "vault_spend_proofs" "missing_balance_commitment")))

(with-gate ("DEP-18 ruleset gating: the shared ruleset_gating vector")
  (when (uiop:getenv "CL_DEPOSITS_WRITE_VECTORS")
    (let* ((op-priv 929292) (pa (up:compressed-pubkey (tk op-priv)))
           (zero (make-array 32 :element-type '(unsigned-byte 8) :initial-element 0))
           (block (lambda (h) (u:sha256 (u:ascii->bytes (format nil "gating block ~a" h)))))
           (challenge (list :type :quorum-challenge :challenged-ledger-id (u:sha256 (hx "c1")) :challenged-txid (u:sha256 (hx "c2"))
                            :challenged-anchor (u:sha256 (hx "c3")))))
      (with-open-file (o (vector-path "ruleset_gating.txt") :direction :output :if-exists :supersede)
        (format o "# DEP-18 ruleset gating (shared cl-deposits / deposits-rust), generated by cl-deposits~%")
        (format o "# (inspect/rotation-test.lisp with CL_DEPOSITS_WRITE_VECTORS).  ruleset NAME family F rules R,..: the~%")
        (format o "# registry.  born_expired RULESET EXPIRY HEIGHT VIOLATION and collateral_floor RULESET RESERVES~%")
        (format o "# COLLATERAL FLOOR_BPS VIOLATION: a QuorumBegin judged under the ruleset it names (- for none).~%")
        (format o "# header cases: a LedgerOpen naming RULESET (- for none), the fault, and whether a~%")
        (format o "# NonConformingUpdate proof of it verifies.  The vault-spend twins are in vault_spend_anchor.txt.~%")
        (dolist (r *registry-rules*)
          (format o "ruleset ~a family cltv-offset-v2 rules ~:[-~;~:*~{~a~^,~}~]~%" (car r) (cdr r)))
        (dolist (rs '("anchor-ladder-v5" "balance-anchor-v6" "cltv-offset-v2" "balance-commit-v4" nil))
          (dolist (c '((100 100) (99 100) (101 100)))
            (format o "born_expired ~a ~a ~a ~a~%" (or rs "-") (first c) (second c)
                    (if (lg:born-expired-p rs (first c) (second c)) 1 0)))
          (dolist (c '((80000001 19999999) (80000000 20000000)))
            (format o "collateral_floor ~a ~a ~a 2000 ~a~%" (or rs "-") (first c) (second c)
                    (if (lg:collateral-below-floor-p rs (first c) (second c) 2000) 1 0))))
        (dolist (rs '("anchor-ladder-v5" "balance-anchor-v6" "cltv-offset-v2" nil))
          (let* ((open (append (list :type :ledger-open :operator-id pa :reserves-id (format nil "gating:~a" (or rs "none"))
                                     :genesis-block 150 :reserves-amount 1000 :collateral-amount 500)
                               (when rs (list :protocol-version rs))))
                 (lid (op:compute-ledger-id pa (getf open :reserves-id) 150))
                 (mk (lambda (seq prev op height hash)
                       (let ((u (up:make-signed-update :operator-id pa :ledger-id lid :seq seq :prev-hash prev
                                                       :block-height height :block-hash hash :message (op:encode-operation op))))
                         (up:sign-operator u (tk op-priv)) u)))
                 (u0 (funcall mk 0 zero open 150 (funcall block 150))))
            (loop for (name history fault) in
                  (list (list "equal_height" (list u0) (funcall mk 1 (up:chain-hash u0) challenge 150 (funcall block 150)))
                        (list "decreasing_height" (list u0) (funcall mk 1 (up:chain-hash u0) challenge 149 (funcall block 149)))
                        (list "zero_hash" (list u0) (funcall mk 1 (up:chain-hash u0) challenge 151 zero))
                        (list "genesis_zero_hash" '() (funcall mk 0 zero open 150 zero)))
                  do (format o "case ~a_~a~%" name (or rs "none"))
                     (dolist (u history) (format o "update ~a~%" (u:bytes->hex (up:encode-update u))))
                     (format o "fault ~a~%" (u:bytes->hex (up:encode-update fault)))
                     (format o "verdict ~a~%"
                             (if (fr::verify-non-conforming-update
                                  (fr::make-non-conforming-update-proof pa lid fault) history)
                                 1 0))))))))
  (let ((history '()) (fault nil) (name nil) (counts (make-hash-table :test #'equal)))
    (with-open-file (in (vector-path "ruleset_gating.txt"))
      (loop for line = (read-line in nil) while line
            unless (or (zerop (length line)) (char= (char line 0) #\#))
              do (let* ((w (uiop:split-string line :separator " ")) (rs (and (second w) (if (string= (second w) "-") nil (second w)))))
                   (incf (gethash (first w) counts 0))
                   (cond
                     ((string= (first w) "ruleset")
                      (let ((rules (if (string= (sixth w) "-") '() (uiop:split-string (sixth w) :separator ","))))
                        (check (format nil "~a is registered" (second w)) (member (second w) lg:+rulesets+ :test #'string=))
                        (check-equal (format nil "~a: family" (second w)) (lg:reserves-family (second w)) (fourth w))
                        (check-equal (format nil "~a: the gated rules this implementation enforces" (second w))
                                     (sort (mapcar (lambda (k) (substitute #\_ #\- (string-downcase (symbol-name k))))
                                                   (cdr (assoc (second w) lg:+ruleset-rules+ :test #'string=)))
                                           #'string<)
                                     (sort (copy-list rules) #'string<))))
                     ((string= (first w) "born_expired")
                      (check-equal (format nil "born expired under ~a: ~a at ~a" (second w) (third w) (fourth w))
                                   (if (lg:born-expired-p rs (parse-integer (third w)) (parse-integer (fourth w))) "1" "0") (fifth w)))
                     ((string= (first w) "collateral_floor")
                      (check-equal (format nil "collateral floor under ~a: ~a of ~a" (second w) (fourth w) (third w))
                                   (if (lg:collateral-below-floor-p rs (parse-integer (third w)) (parse-integer (fourth w)) (parse-integer (fifth w))) "1" "0")
                                   (sixth w)))
                     ((string= (first w) "case") (setf name (second w) history '()))
                     ((string= (first w) "update") (setf history (append history (list (up:decode-update (u:hex->bytes (second w)))))))
                     ((string= (first w) "fault") (setf fault (up:decode-update (u:hex->bytes (second w)))))
                     ((string= (first w) "verdict")
                      (check-equal (format nil "header case ~a" name)
                                   (parse-integer (second w))
                                   (if (fr::verify-non-conforming-update
                                        (fr::make-non-conforming-update-proof (up:update-operator-id fault) (up:update-ledger-id fault) fault)
                                        history)
                                       1 0)))))))
    (check-equal "gating vector counts" (list (gethash "ruleset" counts) (gethash "born_expired" counts)
                                              (gethash "collateral_floor" counts) (gethash "verdict" counts))
                 '(5 15 10 16))))


;;;; inspect/gen-confiscation-vault-rung.lisp — the shared vector
;;;; inspect/vectors/confiscation_vault_rung.txt (deposits-rust:
;;;; deposits-node/tests/vectors/confiscation_vault_rung.txt), from a live regtest ledger whose
;;;; rotation confirmed at a higher rung and whose vault was then confiscated
;;;; (redteam/check-confiscation-vault-rung.sh).  Same format as authorised_confiscation.txt; the
;;;; confirmed vault rung is one more `pledge` line (txid vout sats height), which is what a judge's
;;;; chain answers for the spend's input.
;;;;
;;;;   sbcl --script ... (env: GEN_LEDGER, GEN_SPEND, GEN_RELAY, GEN_CLI, GEN_OUT)
(require :asdf)
(handler-bind ((warning #'muffle-warning)) (asdf:load-system "cl-deposits"))
(in-package :cl-deposits.node)

(defun env (k &optional d) (or (uiop:getenv k) d))
(defun cli (&rest args)
  (string-trim '(#\Newline #\Space)
               (uiop:run-program (append (uiop:split-string (env "GEN_CLI") :separator " ") args) :output :string)))
(defun tx-json (txid) (json-simple:parse (cli "getrawtransaction" txid "1")))

(let* ((id (env "GEN_LEDGER")) (spend-id (env "GEN_SPEND"))
       (bus (cl-deposits.nostr-bus:make-nostr-bus (list (env "GEN_RELAY"))))
       (node (make-node :priv (gossamer:pooled-copy (hex->bytes (format nil "~64,'0x" 7))) :bus bus :network "regtest")))
  (cl-deposits.nostr-bus:wait-for-bus bus :seconds 20)
  (let* ((updates (ledger-updates-from-relays node id))
         (sj (tx-json spend-id))
         (spend-hex (gethash "hex" sj))
         (spend-height (- (1+ (parse-integer (cli "getblockcount"))) (gethash "confirmations" sj)))
         (vin (aref (gethash "vin" sj) 0))
         (rung-id (gethash "txid" vin)) (rung-vout (gethash "vout" vin))
         (rj (tx-json rung-id))
         (rung-sats (round (* 100000000 (gethash "value" (aref (gethash "vout" rj) rung-vout)))))
         (rung-height (- (1+ (parse-integer (cli "getblockcount"))) (gethash "confirmations" rj)))
         (spend (btx:parse-tx (bw:make-reader (hex->bytes spend-hex))))
         ;; a negative case: the same spend with its change output one sat short
         (short (let* ((outs (btx:tx-outputs spend)) (c (second outs)))
                  (bytes->hex (btx:serialize-tx
                               (btx:make-tx :version (btx:tx-version spend) :locktime (btx:tx-locktime spend) :segwit-p t
                                            :inputs (btx:tx-inputs spend)
                                            :outputs (list* (first outs) (btx:make-txout :value (1- (btx:txout-value c)) :script (btx:txout-script c))
                                                            (cddr outs))
                                            :witnesses (btx:tx-witnesses spend)))))))
    (with-open-file (o (env "GEN_OUT") :direction :output :if-exists :supersede)
      (format o "# DEP-03 Fee ladder / DEP-06 \"Authorised confiscation\": a confiscation of a vault whose rotation~%")
      (format o "# confirmed at a higher rung (shared cl-deposits / deposits-rust), generated by cl-deposits~%")
      (format o "# (inspect/gen-confiscation-vault-rung.lisp) from regtest (redteam/check-confiscation-vault-rung.sh).~%")
      (format o "# A judge reads the rung from the spend's input and the vault's value from that rung's output,~%")
      (format o "# never rung 0's recorded amounts (signet soak, 2026-11-08: ledger G, a false challenge and~%")
      (format o "# contagion). The vault rung is a pledge line (txid vout sats height). 1 = excused.~%")
      (format o "network regtest~%ledger ~a~%spend_height ~a~%" id spend-height)
      (dolist (u updates) (format o "update ~a~%" (bytes->hex (up:encode-update u))))
      ;; every DisputeArmed pledge, as its outpoint's (vout sats height) the chain reports
      (dolist (u updates)
        (let ((o2 (ignore-errors (op:update-op u))))
          (when (and o2 (eq (ignore-errors (op:update-type u)) :dispute-armed) (op:field o2 :replacement-collateral-txid))
            (let* ((pint (op:field o2 :replacement-collateral-txid)) (pv (op:field o2 :replacement-collateral-vout))
                   (pj (ignore-errors (tx-json (txid-hex pint)))))
              (when pj
                (format o "pledge ~a ~a ~a ~a~%" (bytes->hex pint) pv
                        (round (* 100000000 (gethash "value" (aref (gethash "vout" pj) pv))))
                        (- (1+ (parse-integer (cli "getblockcount"))) (gethash "confirmations" pj))))))))
      ;; internal byte order, as every pledge line (bitcoin-cli prints display order)
      (format o "pledge ~a ~a ~a ~a~%" (bytes->hex (reverse (hex->bytes rung-id))) rung-vout rung-sats rung-height)
      (format o "case bumped_vault 1 ~a~%" spend-hex)
      (format o "case bumped_vault_short 0 ~a~%" short))
    (format t "~&wrote ~a (~a updates, vault rung ~a:~a ~a sats)~%" (env "GEN_OUT") (length updates) rung-id rung-vout rung-sats)))
